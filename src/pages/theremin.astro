---
import Base from '../layouts/Base.astro';
import CoachBand from '../components/CoachBand.astro';
import SongLibrary from '../components/SongLibrary.astro';
import SettingsCard from '../components/SettingsCard.astro';
import InstrumentFooter from '../components/InstrumentFooter.astro';
import Icon from '../components/Icon.astro';
import '../styles/instrument.css';
import '../styles/theremin.css';
import { instrumentBySlug, instrumentJsonLd, breadcrumbJsonLd } from '../data/instruments';
import { SITE, withBase } from '../lib/site';

const inst = instrumentBySlug('theremin');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(withBase('og/theremin.png'), Astro.site).href;
---

<Base
  title={`Aetherwave — Play a Theremin Online | ${SITE.name}`}
  description={inst.description}
  image="og/theremin.png"
  imageAlt="A glowing cyan oscilloscope waveform between two brass theremin antennas in the dark."
  keywords={inst.keywords}
  jsonLd={[instrumentJsonLd(inst, url, image), breadcrumbJsonLd(inst, url, Astro.site!)]}
  themeColor="#08080f"
  favicon="favicon-theremin.svg"
>
  <main class="shell" id="main">
    <a class="skip-link" href="#songs">Skip to songs</a>
    <header class="top">
      <div class="brand">
        <h1 class="title">Aether<span>wave</span></h1>
        <p class="tag">Léon Theremin's 1920 instrument, played <b>without touching it</b>. Move through the field — right for pitch, up for volume — or tilt your phone and hear it sing.</p>
      </div>
      <div class="head-controls">
        <div class="readout-top" aria-live="off">
          <div class="hz" id="hzTop">— Hz</div>
          <div class="nm" id="noteTop">power on to play</div>
        </div>
        <button class="tilt-toggle" id="tiltToggle" type="button" aria-pressed="false" hidden><Icon name="tilt" /><span id="tiltLabel">Tilt to play</span></button>
      </div>
    </header>

    <div class="practice wide">
      <section class="stage" aria-label="Theremin">
        <div class="field-box">
          <!-- a sibling of the field, not inside it: a slider's children are hidden from assistive tech -->
          <button class="power" id="power" type="button" aria-label="Power on the theremin">
            <span class="btn-power">
              <span class="ring"><Icon name="power" size={30} /></span>
              <span class="plabel">Power on</span>
              <span class="psub kbd-hint">Then glide your cursor through the field — no clicking needed. Keyboard: focus the field and use the arrow keys.</span>
              <span class="psub touch-hint">Then drag through the field — or turn on tilt and move your phone.</span>
            </span>
          </button>
          <div class="field-wrap" id="field">
            <canvas id="scope" aria-hidden="true"></canvas>
            <div class="ruler" id="ruler" aria-hidden="true"></div>
            <div class="antenna vol" aria-hidden="true"><span class="glow"></span></div>
            <div class="antenna pitch" aria-hidden="true"><span class="glow"></span></div>
            <div class="rings" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="cross h" id="crossH" aria-hidden="true"></div>
            <div class="cross v" id="crossV" aria-hidden="true"></div>
            <div class="target" id="target" aria-hidden="true"><span class="band"></span><span class="lab" id="targetLab"></span></div>
            <div class="cursor" id="cursor" aria-hidden="true"></div>
            <div class="cursor-read" id="cursorRead" aria-hidden="true"></div>
            <div class="tiltind" id="tiltind" aria-hidden="true"><span class="bub" id="tiltbub"></span></div>
          </div>
        </div>
        <div class="field-foot">
          <span id="hintPointer">← low <b>pitch</b> high → &nbsp;·&nbsp; ↓ soft <b>volume</b> loud ↑</span>
          <span id="hintTilt" hidden>Rotate → <b>pitch</b> · tilt → <b>volume</b> · shake → vibrato · tap the field to recenter</span>
          <span class="badge"><i class="c"></i>you&nbsp;&nbsp;<i class="v"></i>signal&nbsp;&nbsp;<i class="t"></i>on target</span>
        </div>
        <noscript><p class="field-foot">The theremin needs JavaScript to make sound.</p></noscript>
      </section>

      <CoachBand idle="Pick a song: the theremin plays it first, then a glowing band shows where to move your hand." />

      <div class="lower">
        <SongLibrary />
        <SettingsCard title="Voice" tempo={false}>
          <div class="row"><label for="glide">Glide</label><input type="range" id="glide" min="0" max="100" value="24" /><span class="val" id="glideV">medium</span></div>
          <div class="row"><label for="vibRate">Vibrato rate</label><input type="range" id="vibRate" min="0" max="90" value="55" /><span class="val" id="vibRateV">5.5 Hz</span></div>
          <div class="row"><label for="vibDepth">Vibrato depth</label><input type="range" id="vibDepth" min="0" max="80" value="22" /><span class="val" id="vibDepthV">22 ¢</span></div>
          <div class="row"><label for="timbre">Timbre</label><input type="range" id="timbre" min="0" max="100" value="42" /><span class="val" id="timbreV">voice</span></div>
          <div class="row"><label for="reverb">Space</label><input type="range" id="reverb" min="0" max="100" value="34" /><span class="val" id="reverbV">34%</span></div>
          <div class="row"><label for="scale">Scale assist</label>
            <select id="scale">
              <option value="off" selected>Off — true glide</option>
              <option value="chromatic">Chromatic</option>
              <option value="major">C major</option>
              <option value="pentatonic">C pentatonic</option>
            </select>
          </div>
        </SettingsCard>
      </div>
    </div>

    <InstrumentFooter slug="theremin">
      One continuous voice, <b>synthesized live</b> with the Web Audio API. All melodies are <b>public-domain / traditional</b>.
    </InstrumentFooter>
  </main>
</Base>

<script>
  import '../scripts/theremin.ts';
</script>
