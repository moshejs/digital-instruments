---
/** One page per song this instrument can play, e.g. /harp/ode-to-joy/. */
import InstrumentPage from '../../layouts/InstrumentPage.astro';
import Harp from '../../instruments/Harp.astro';
import { songsFor } from '../../data/song-pages';
import type { Song } from '../../data/songs';

export const getStaticPaths = () => songsFor('harp').map((song) => ({ params: { song: song.id }, props: { song } }));
const { song } = Astro.props as { song: Song };
---

<InstrumentPage slug="harp" song={song}>
  <Harp song={song} />
</InstrumentPage>
