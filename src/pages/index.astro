---
import Base from '../layouts/Base.astro';
import { INSTRUMENTS, fullName } from '../data/instruments';
import { SONGS, playableCount } from '../data/songs';
import { buildPads } from '../lib/steelpan-layout';
import { SITE, withBase } from '../lib/site';

const home = new URL(withBase(), Astro.site).href;
const pads = buildPads();
const [steelpan, theremin] = INSTRUMENTS;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: home,
    description: SITE.description,
    inLanguage: 'en',
    author: { '@type': 'Person', name: SITE.author, url: 'https://github.com/moshejs' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Instruments',
    itemListElement: INSTRUMENTS.map((inst, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(withBase(`${inst.slug}/`), Astro.site).href,
      name: fullName(inst),
    })),
  },
];
---

<Base
  title={`${SITE.name} — Steelpan & Theremin in Your Browser`}
  description={SITE.description}
  image="og/home.png"
  imageAlt="Moshe's Digital Instruments: a chrome steelpan and a glowing theremin waveform side by side."
  keywords={['online instruments', 'browser instruments', 'virtual steel drum', 'online theremin', 'Web Audio API', 'learn music', 'play along', 'public domain songs']}
  jsonLd={jsonLd}
>
  <main class="home">
    <header class="hero">
      <p class="eyebrow">Workshop catalogue · {new Date().getFullYear()}</p>
      <h1>
        <span class="owner">Moshe's</span>
        <span class="word">Digital Instruments</span>
      </h1>
      <div class="signal" aria-hidden="true"></div>
      <p class="lede">
        Real instruments, synthesized note by note in your browser. No samples, no installs —
        click, hover, or tilt your phone, and learn nine songs with a guide that lights the way.
      </p>
    </header>

    <section class="catalogue" aria-label="Instruments">
      <article class="plate plate-pan">
        <a class="plate-link" href={withBase('steelpan/')} aria-label={steelpan.cta}></a>
        <div class="plate-head">
          <span class="no">{steelpan.catalogNo}</span>
          <h2>{steelpan.name}</h2>
        </div>
        <div class="visual pan-visual" aria-hidden="true">
          <div class="mini-pan" data-mini-pan>
            {pads.map((p) => (
              <span
                class="mini-pad"
                data-note={p.note}
                style={`left:${p.x}%;top:${p.y}%;width:${p.w}%;height:${p.h}%`}
              />
            ))}
          </div>
        </div>
        <p class="tagline">{steelpan.tagline}</p>
        <dl class="specs">
          {steelpan.specs.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        <span class="cta">{steelpan.cta} <span aria-hidden="true">→</span></span>
      </article>

      <article class="plate plate-wave">
        <a class="plate-link" href={withBase('theremin/')} aria-label={theremin.cta}></a>
        <div class="plate-head">
          <span class="no">{theremin.catalogNo}</span>
          <h2>{theremin.name} <em>“{theremin.displayName}”</em></h2>
        </div>
        <div class="visual wave-visual" aria-hidden="true">
          <span class="ant ant-loop"></span>
          <span class="ant ant-rod"></span>
          <canvas data-mini-scope></canvas>
        </div>
        <p class="tagline">{theremin.tagline}</p>
        <dl class="specs">
          {theremin.specs.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
        </dl>
        <span class="cta">{theremin.cta} <span aria-hidden="true">→</span></span>
      </article>
    </section>

    <section class="songbook" id="songbook" aria-labelledby="songbook-title">
      <div class="section-head">
        <h2 id="songbook-title">The Songbook</h2>
        <p>Nine public-domain melodies, playable on both instruments. Each was transcribed, then re-derived note by note by an independent second pass that corrected mistakes before they shipped.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col">Song</th><th scope="col">Origin</th><th scope="col">Key</th><th scope="col">Time</th><th scope="col">Notes</th><th scope="col">Level</th><th scope="col"><span class="sr">Play on</span></th></tr>
          </thead>
          <tbody>
            {SONGS.map((s) => (
              <tr>
                <th scope="row">{s.title}</th>
                <td class="muted">{s.origin}</td>
                <td>{s.key}</td>
                <td class="num">{s.timeSignature}</td>
                <td class="num">{playableCount(s)}</td>
                <td><span class={`level ${s.difficulty.toLowerCase()}`}>{s.difficulty}</span></td>
                <td class="play">
                  <a href={`${withBase('steelpan/')}?song=${s.id}`} class="go go-pan">Steelpan</a>
                  <a href={`${withBase('theremin/')}?song=${s.id}`} class="go go-wave">Theremin</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="workshop" aria-labelledby="workshop-title">
      <h2 id="workshop-title" class="section-title">How they're made</h2>
      <div class="notes">
        <div>
          <h3>Synthesized, not sampled</h3>
          <p>The steelpan stacks seven tuned partials — a hand-detuned octave and twelfth over a fast metallic ping — on a filtered-noise strike. The theremin is one continuous voice: two oscillators crossfaded for timbre, a vibrato LFO and portamento glide.</p>
        </div>
        <div>
          <h3>Learn by following the light</h3>
          <p><b>Listen</b> plays the tune for you. <b>Play Along</b> lights the next pad on the steelpan, or sweeps a target band across the theremin field and scores how long you stay on pitch.</p>
        </div>
        <div>
          <h3>Played with your body</h3>
          <p>Strike pads with a click, a tap or a piano-style keyboard. On a phone, the theremin reads your gyroscope and accelerometer: roll for pitch, tilt for volume, shake for vibrato.</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <span>© {new Date().getFullYear()} {SITE.author}</span>
    <span>Built with Astro and the Web Audio API · MIT licensed</span>
    <a href={SITE.repo} rel="noopener">Source on GitHub</a>
  </footer>
</Base>

<style is:global>
  html { background: #121110; }
  body {
    margin: 0;
    background:
      radial-gradient(90% 60% at 15% 0%, rgba(246, 178, 60, 0.07), transparent 60%),
      radial-gradient(80% 60% at 90% 10%, rgba(92, 242, 214, 0.06), transparent 60%),
      #121110;
    color: #edeae3;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
</style>

<style>
  .home {
    --ink: #edeae3;
    --ink-2: #a8a39a;
    --ink-3: #6e6a63;
    --rule: rgba(237, 234, 227, 0.12);
    --plate: #1a1917;
    --amber: #f6b23c;
    --teal: #2ad4c4;
    --cyan: #5cf2d6;
    --magenta: #ff5db0;
    --brass: #d8a24a;
    --display: 'Big Shoulders Display', 'Arial Narrow', sans-serif;
    --mono: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 34px);
  }

  /* ── hero ── */
  .hero { padding: clamp(40px, 8vw, 96px) 0 clamp(28px, 5vw, 56px); }
  .eyebrow {
    margin: 0 0 18px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  h1 { margin: 0; font-family: var(--display); text-transform: uppercase; line-height: 0.86; text-wrap: balance; }
  h1 .owner { display: block; font-weight: 700; font-size: clamp(22px, 3.4vw, 40px); letter-spacing: 0.18em; color: var(--ink-2); }
  h1 .word { display: block; font-weight: 800; font-size: clamp(54px, 12.5vw, 168px); letter-spacing: 0.01em; }
  .signal {
    height: 3px;
    width: min(100%, 760px);
    margin: clamp(18px, 3vw, 28px) 0;
    border-radius: 3px;
    background: linear-gradient(90deg, var(--amber), var(--teal) 45%, var(--cyan) 70%, var(--magenta));
    box-shadow: 0 0 18px rgba(92, 242, 214, 0.35);
    transform-origin: left;
    animation: draw 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both 0.15s;
  }
  @keyframes draw { from { transform: scaleX(0); } }
  .lede { margin: 0; max-width: 60ch; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--ink-2); }

  /* ── catalogue plates ── */
  .catalogue { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 28px); }
  @media (max-width: 860px) { .catalogue { grid-template-columns: 1fr; } }
  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(18px, 2.6vw, 30px);
    background: var(--plate);
    border: 1px solid var(--rule);
    border-radius: 6px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .plate:hover { transform: translateY(-2px); }
  .plate-pan:hover { border-color: rgba(246, 178, 60, 0.5); }
  .plate-wave:hover { border-color: rgba(92, 242, 214, 0.5); }
  .plate-link { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .plate-link:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }
  .plate-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .plate-head h2 { margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(34px, 4.6vw, 54px); text-transform: uppercase; line-height: 0.9; }
  .plate-head h2 em { font-style: normal; font-weight: 700; font-size: 0.5em; letter-spacing: 0.06em; color: var(--cyan); }
  .no { order: 2; font-family: var(--mono); font-size: 12px; letter-spacing: 0.1em; color: var(--ink-3); }
  .tagline { margin: 0; font-size: 16px; line-height: 1.55; color: var(--ink); max-width: 46ch; }

  .visual { position: relative; aspect-ratio: 16 / 10; border-radius: 4px; overflow: hidden; }
  .pan-visual { display: grid; place-items: center; background: radial-gradient(70% 70% at 50% 40%, rgba(246, 178, 60, 0.14), transparent 70%), #0b1315; }
  .mini-pan {
    position: relative;
    height: 88%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 34%, #cfdadd, #5b666b 46%, #2c3539 74%, #161d20);
    box-shadow: inset 0 3px 6px rgba(255, 255, 255, 0.28), inset 0 -14px 30px rgba(0, 0, 0, 0.6), 0 20px 40px -14px rgba(0, 0, 0, 0.7);
  }
  .mini-pan::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(46% 30% at 34% 20%, rgba(255, 255, 255, 0.4), transparent 70%);
    pointer-events: none;
  }
  .mini-pad {
    position: absolute;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 42% 30%, #f2f7f8, #cfdadd 30%, #5b666b 72%, #2c3539);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.5), inset 0 -3px 6px rgba(0, 0, 0, 0.45);
    transition: box-shadow 0.25s, filter 0.25s;
  }
  .mini-pad.on { filter: brightness(1.2); box-shadow: inset 0 0 0 1px var(--amber), 0 0 16px rgba(246, 178, 60, 0.8); }

  .wave-visual { background: radial-gradient(90% 90% at 50% 120%, #0a1620, transparent 60%), #07070d; }
  .wave-visual canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ant { position: absolute; z-index: 1; }
  .ant-rod { right: 7%; top: 12%; bottom: 12%; width: 2px; background: linear-gradient(180deg, var(--brass), #8a6a2f); box-shadow: 0 0 10px rgba(216, 162, 74, 0.5); }
  .ant-loop { left: 6%; top: 50%; width: 9%; aspect-ratio: 0.62; transform: translateY(-50%); border: 2px solid #8a6a2f; border-radius: 50%; }

  .specs { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
  .specs div { padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .specs dt { font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .specs dd { margin: 3px 0 0; font-family: var(--mono); font-size: 13px; color: var(--ink); }
  .cta { margin-top: auto; font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
  .plate-pan .cta { color: var(--amber); }
  .plate-wave .cta { color: var(--cyan); }

  /* ── songbook ── */
  .songbook, .workshop { padding-top: clamp(56px, 8vw, 96px); }
  .section-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 24px; align-items: end; margin-bottom: 22px; }
  @media (max-width: 760px) { .section-head { grid-template-columns: 1fr; } }
  .section-head h2, .section-title { margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(36px, 5vw, 64px); text-transform: uppercase; line-height: 0.9; }
  .section-head p { margin: 0; color: var(--ink-2); line-height: 1.6; max-width: 62ch; }
  .table-wrap { overflow-x: auto; border-top: 1px solid var(--rule); }
  table { width: 100%; border-collapse: collapse; min-width: 760px; font-size: 14.5px; }
  th, td { text-align: left; padding: 13px 12px 13px 0; border-bottom: 1px solid var(--rule); vertical-align: middle; }
  thead th { font-family: var(--mono); font-weight: 400; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  tbody th { font-weight: 600; }
  .muted { color: var(--ink-2); }
  .num { font-family: var(--mono); font-variant-numeric: tabular-nums; }
  .level { font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; border: 1px solid; }
  .level.easy { color: #57d98a; }
  .level.medium { color: var(--amber); }
  .level.hard { color: var(--magenta); }
  .play { white-space: nowrap; text-align: right; padding-right: 0; }
  .go { font-family: var(--mono); font-size: 12px; text-decoration: none; padding: 5px 9px; border-radius: 4px; border: 1px solid var(--rule); color: var(--ink); margin-left: 6px; transition: border-color 0.15s, color 0.15s; }
  .go-pan:hover { border-color: var(--amber); color: var(--amber); }
  .go-wave:hover { border-color: var(--cyan); color: var(--cyan); }
  .go:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ── workshop notes ── */
  .notes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 3vw, 40px); margin-top: 26px; border-top: 1px solid var(--rule); padding-top: 22px; }
  @media (max-width: 860px) { .notes { grid-template-columns: 1fr; } }
  .notes h3 { margin: 0 0 8px; font-size: 17px; font-weight: 600; }
  .notes p { margin: 0; color: var(--ink-2); line-height: 1.65; font-size: 15px; }
  .notes b { color: var(--ink); font-weight: 600; }

  .site-foot {
    max-width: 1240px;
    margin: clamp(64px, 9vw, 110px) auto 0;
    padding: 22px clamp(16px, 3vw, 34px) 34px;
    border-top: 1px solid rgba(237, 234, 227, 0.12);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 26px;
    justify-content: space-between;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 12px;
    color: #6e6a63;
  }
  .site-foot a { color: #a8a39a; }
  .site-foot a:hover { color: #edeae3; }

  @media (prefers-reduced-motion: reduce) {
    .signal { animation: none; }
    .plate, .plate:hover { transform: none; }
  }
</style>

<script>
  import { SONGS } from '../data/songs';
  import { REST, noteToFreq } from '../lib/music';

  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** The mini pan silently "plays" Ode to Joy, lighting each pad in time. */
  function animatePan(): void {
    const pan = document.querySelector<HTMLElement>('[data-mini-pan]');
    const song = SONGS.find((s) => s.id === 'ode-to-joy');
    if (!pan || !song) return;
    const pads = new Map([...pan.querySelectorAll<HTMLElement>('.mini-pad')].map((p) => [p.dataset.note!, p]));
    if (still) {
      pads.get('E4')?.classList.add('on');
      return;
    }
    const beatMs = 60000 / 92;
    let i = 0;
    const step = () => {
      const n = song.notes[i % song.notes.length];
      const pad = n.note === REST ? undefined : pads.get(n.note);
      pad?.classList.add('on');
      window.setTimeout(() => pad?.classList.remove('on'), Math.min(n.beats * beatMs * 0.8, 420));
      i++;
      window.setTimeout(step, n.beats * beatMs + (i % song.notes.length === 0 ? 1600 : 0));
    };
    step();
  }

  /** A miniature oscilloscope whose pitch glides through Greensleeves. */
  function animateScope(): void {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-mini-scope]');
    const song = SONGS.find((s) => s.id === 'greensleeves');
    if (!canvas || !song) return;
    const ctx = canvas.getContext('2d')!;
    const notes = song.notes.filter((n) => n.note !== REST);
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const resize = () => {
      canvas.width = canvas.clientWidth * dpr;
      canvas.height = canvas.clientHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    window.addEventListener('resize', resize);
    let cycles = 3;
    let target = 3;
    let phase = 0;
    let index = 0;
    let nextAt = 0;
    const draw = (t: number) => {
      if (t >= nextAt) {
        const n = notes[index % notes.length];
        target = 2 + (noteToFreq(n.note) / 220) * 2.2; // wave density follows the melody
        nextAt = t + n.beats * 520;
        index++;
      }
      cycles += (target - cycles) * 0.06; // portamento
      phase += 0.05;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = 'rgba(150,170,255,.1)';
      ctx.beginPath();
      ctx.moveTo(0, h / 2);
      ctx.lineTo(w, h / 2);
      ctx.stroke();
      ctx.lineWidth = 2;
      ctx.strokeStyle = '#5cf2d6';
      ctx.shadowColor = '#5cf2d6';
      ctx.shadowBlur = 12;
      ctx.beginPath();
      for (let x = 0; x <= w; x += 2) {
        const u = x / w;
        const env = Math.sin(Math.PI * u);
        const y = h / 2 + Math.sin(u * cycles * Math.PI * 2 + phase) * h * 0.3 * env
          + Math.sin(u * cycles * Math.PI * 4 + phase * 1.3) * h * 0.06 * env;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.shadowBlur = 0;
      if (!still) requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }

  animatePan();
  animateScope();
</script>
