---
import Base from '../layouts/Base.astro';
import { SITE, withBase } from '../lib/site';
import { INSTRUMENTS } from '../data/instruments';
---

<Base
  title={`Off the scale — ${SITE.name}`}
  description="This page doesn't exist. Head back to one of the five instruments."
  image="og/home.png"
  imageAlt={SITE.name}
  noindex
>
  <main class="lost" id="main">
    <h1>That note isn't on this instrument.</h1>
    <p>That page doesn't exist (error 404). Pick an instrument instead:</p>
    <ul class="links">
      {INSTRUMENTS.map((i) => <li><a href={withBase(`${i.slug}/`)} style={`--hover:${i.accent}`}>{i.name}</a></li>)}
      <li><a href={withBase()}>All instruments</a></li>
    </ul>
    <p class="credit">Built by <a href="https://www.quentin.software/">Quentin.Code</a></p>
  </main>
</Base>

<style is:global>
  html, body { margin: 0; background: #121110; color: #edeae3; font-family: 'IBM Plex Sans', system-ui, sans-serif; }
</style>

<style>
  .lost { max-width: 760px; margin: 0 auto; padding: clamp(60px, 14vh, 140px) clamp(16px, 4vw, 34px); }
  h1 { margin: 0 0 16px; font-family: 'Big Shoulders Display', sans-serif; font-weight: 800; text-transform: uppercase; font-size: clamp(44px, 9vw, 96px); line-height: 0.9; text-wrap: balance; }
  p { color: #a8a39a; line-height: 1.6; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin: 26px 0 0; padding: 0; list-style: none; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; font-family: 'IBM Plex Mono', monospace; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; text-decoration: none; color: #edeae3; border: 1px solid rgba(237, 234, 227, 0.2); padding: 0 14px; border-radius: 4px; }
  .links a:hover { border-color: var(--hover, #edeae3); color: var(--hover, #edeae3); }
  .links a:focus-visible { outline: 2px solid #5cf2d6; outline-offset: 2px; }
  .credit { margin-top: 40px; font-size: 13px; }
  .credit a { color: #edeae3; }
</style>
