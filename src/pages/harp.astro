---
import Base from '../layouts/Base.astro';
import SongPanel from '../components/SongPanel.astro';
import InstrumentFooter from '../components/InstrumentFooter.astro';
import '../styles/instrument.css';
import '../styles/harp.css';
import { instrumentBySlug, instrumentJsonLd, breadcrumbJsonLd } from '../data/instruments';
import { SITE, withBase } from '../lib/site';

const inst = instrumentBySlug('harp');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(withBase('og/harp.png'), Astro.site).href;
---

<Base
  title={`Lever Harp — Play a Harp Online | ${SITE.name}`}
  description={inst.description}
  image="og/harp.png"
  imageAlt="A walnut lever harp with fifteen strings — red C strings, blue F strings — one glowing gold as it is plucked."
  keywords={inst.keywords}
  jsonLd={[instrumentJsonLd(inst, url, image), breadcrumbJsonLd(inst, url, Astro.site!)]}
  themeColor="#140b0e"
  favicon="favicon-harp.svg"
>
  <div class="shell">
    <header class="top">
      <div class="brand">
        <div class="eyebrow">{inst.catalogNo} · Celtic lever harp</div>
        <h1 class="title">Lever Harp</h1>
        <p class="tag"><b>Pluck a string</b>, or <b>drag across</b> them for a glissando. The little levers at the top raise a string a semitone — red strings are C, blue are F.</p>
      </div>
      <div class="readout" aria-live="off"><span class="n" id="lastNote">—</span><span class="h">last string</span></div>
    </header>

    <div class="grid">
      <section class="stage" aria-label="Lever harp — pluck or drag across the strings, or use the number keys">
        <div class="harp-wrap"><svg id="harp" role="img" aria-label="A 15-string lever harp"></svg></div>
        <div class="stage-foot">
          <span>Keys <kbd>1</kbd>–<kbd>7</kbd> · <kbd>Q</kbd>–<kbd>U</kbd> · <kbd>I</kbd> pluck · <kbd>Shift</kbd>+key flips a lever</span>
          <button class="btn" id="btnReset" type="button">Reset levers to C major</button>
        </div>
        <noscript><p class="stage-foot">The harp needs JavaScript to make sound.</p></noscript>
      </section>

      <SongPanel intro="Pick a tune — the levers set themselves for its key, and flip mid-song when a melody needs it.">
        <div class="row" slot="controls">
          <label for="swAuto">Auto levers</label>
          <span class="switch"><input type="checkbox" id="swAuto" checked /><span class="track"></span><span class="knob"></span></span>
        </div>
        <Fragment slot="legend"><span><i class="a"></i>sounding string · raised lever</span><span><i class="t"></i>play this next</span></Fragment>
      </SongPanel>
    </div>

    <InstrumentFooter slug="harp">
      Every string is <b>physically modelled</b> with Karplus–Strong synthesis. All songs are <b>public-domain / traditional</b>.
    </InstrumentFooter>
  </div>
</Base>

<script>
  import '../scripts/harp.ts';
</script>
