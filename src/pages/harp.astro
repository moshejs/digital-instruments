---
import Base from '../layouts/Base.astro';
import CoachBand from '../components/CoachBand.astro';
import SongLibrary from '../components/SongLibrary.astro';
import SettingsCard from '../components/SettingsCard.astro';
import InstrumentFooter from '../components/InstrumentFooter.astro';
import '../styles/instrument.css';
import '../styles/harp.css';
import { instrumentBySlug, instrumentJsonLd, breadcrumbJsonLd } from '../data/instruments';
import { SITE, withBase } from '../lib/site';

const inst = instrumentBySlug('harp');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(withBase('og/harp.png'), Astro.site).href;
---

<Base
  title={`Lever Harp — Play a Harp Online | ${SITE.name}`}
  description={inst.description}
  image="og/harp.png"
  imageAlt="A walnut lever harp with fifteen strings — red C strings, blue F strings — one glowing gold as it is plucked."
  keywords={inst.keywords}
  jsonLd={[instrumentJsonLd(inst, url, image), breadcrumbJsonLd(inst, url, Astro.site!)]}
  themeColor="#140b0e"
  favicon="favicon-harp.svg"
>
  <main class="shell" id="main">
    <a class="skip-link" href="#songs">Skip to songs</a>
    <header class="top">
      <div class="brand">
        <h1 class="title">Lever Harp</h1>
        <p class="tag">A Celtic lever harp. <b>Pluck a string</b>, or <b>drag across</b> them for a glissando. The levers at the top raise a string a semitone — red strings are C, blue are F.</p>
      </div>
      <div class="head-controls">
        <div class="readout" hidden><span class="n" id="lastNote">—</span><span class="h">last string</span></div>
      </div>
    </header>

    <div class="practice side">
      <section class="stage" aria-label="Lever harp">
        <div class="harp-wrap"><svg id="harp" role="group" aria-label="Harp strings and levers. Pluck with the number keys; Shift plus a key flips that string's lever."></svg></div>
        <div class="stage-foot">
          <span class="kbd-hint">Keys <kbd>1</kbd>–<kbd>7</kbd>, <kbd>Q</kbd>–<kbd>U</kbd>, <kbd>I</kbd> pluck · <kbd>Shift</kbd> + key flips a lever</span>
          <span class="touch-hint">Tap a string to pluck it, or drag across them. Tap a lever to flip it.</span>
          <button class="btn" id="btnReset" type="button">Reset levers to C major</button>
        </div>
        <noscript><p class="stage-foot">The harp needs JavaScript to make sound.</p></noscript>
      </section>

      <div class="rail">
        <CoachBand idle="Pick a song to practise — the levers set themselves for its key — or just play." />
        <SongLibrary />
        <SettingsCard>
          <div class="row">
            <label for="swAuto">Set levers automatically</label>
            <span class="switch"><input type="checkbox" id="swAuto" checked /><span class="track"></span><span class="knob"></span></span>
          </div>
          <Fragment slot="legend"><span><i class="a"></i>sounding · raised lever</span><span><i class="t"></i>play this next</span></Fragment>
        </SettingsCard>
      </div>
    </div>

    <InstrumentFooter slug="harp">
      Every string is <b>physically modelled</b> with Karplus–Strong synthesis. All songs are <b>public-domain / traditional</b>.
    </InstrumentFooter>
  </main>
</Base>

<script>
  import '../scripts/harp.ts';
</script>
