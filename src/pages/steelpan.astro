---
import Base from '../layouts/Base.astro';
import '../styles/steelpan.css';
import { instrumentBySlug, instrumentJsonLd } from '../data/instruments';
import { SITE, withBase } from '../lib/site';

const inst = instrumentBySlug('steelpan');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(withBase('og/steelpan.png'), Astro.site).href;
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: SITE.name, item: new URL(withBase(), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: inst.name, item: url },
  ],
};
---

<Base
  title={`Steelpan — Play a Steel Drum Online | ${SITE.name}`}
  description={inst.description}
  image="og/steelpan.png"
  imageAlt="A gleaming chrome steelpan with 25 note pads, one glowing amber, on a dark stage."
  keywords={inst.keywords}
  jsonLd={[instrumentJsonLd(inst, url, image), breadcrumbs]}
  themeColor="#0b1315"
  favicon="favicon-steelpan.svg"
>
  <div class="shell">
    <header class="top">
      <div class="brand">
        <div class="eyebrow">{inst.catalogNo} · Trinidad &amp; Tobago</div>
        <h1 class="title">STEEL<span class="accent">PAN</span></h1>
        <p class="tag">A playable <b>steel drum</b> synthesized live in your browser. Tap the chrome, or pick a song and <b>follow the lights</b>.</p>
      </div>
      <button class="theme-toggle" id="themeToggle" type="button" aria-label="Switch between stage (dark) and daylight (light) themes">
        <span id="themeIcon">◐</span><span id="themeLabel">Stage</span>
      </button>
    </header>

    <div class="grid">
      <section class="stage" aria-label="Steel pan — click, tap or use the keyboard to play">
        <div class="pan-wrap">
          <div class="pan" id="pan"></div>
          <div class="pads" id="pads"></div>
        </div>
        <div class="pan-foot">
          <div class="now-note"><span class="n" id="freeNote">—</span><span class="h">last struck</span></div>
          <div class="hint-note">Play with your mouse, or the keyboard like a piano <kbd>Z</kbd> <kbd>X</kbd> <kbd>C</kbd> … <kbd>Q</kbd> <kbd>W</kbd> <kbd>E</kbd> …</div>
        </div>
        <noscript><p class="hint-note">The steelpan needs JavaScript to make sound.</p></noscript>
      </section>

      <aside class="panel">
        <div class="card">
          <h2><span class="dot"></span>Song Library</h2>
          <div class="songs" id="songList"></div>
        </div>

        <div class="card player" id="player">
          <div class="phead">
            <span class="ptitle" id="pTitle">Pick a song</span>
            <span class="pmeta" id="pMeta"></span>
          </div>
          <p class="pdesc" id="pDesc">Choose a tune from the library to load the play-along guide.</p>

          <div class="transport">
            <button class="btn primary" id="btnListen" type="button" disabled><span class="ic">▶</span>Listen</button>
            <button class="btn guide" id="btnGuide" type="button" disabled><span class="ic">◎</span>Play Along</button>
            <button class="btn" id="btnStop" type="button" disabled><span class="ic">■</span>Stop</button>
            <button class="btn" id="btnHint" type="button" disabled><span class="ic">♪</span>Hint</button>
          </div>

          <div class="progress"><i id="progFill"></i></div>

          <div class="guide-now idle" id="guideNow" aria-live="polite">
            <div class="big" id="gnNote">—</div>
            <div class="meta">
              <div class="lyr" id="gnLyric">Ready when you are</div>
              <div class="cnt" id="gnCount">—</div>
            </div>
          </div>

          <div class="strip-wrap">
            <div class="playhead"></div>
            <div class="strip" id="strip"></div>
          </div>

          <div class="feedback info" id="feedback" aria-live="polite">Tip: <b>Listen</b> first to hear it, then <b>Play Along</b> to learn it note by note.</div>

          <div class="ctrls">
            <div class="row">
              <label for="tempo">Tempo</label>
              <input type="range" id="tempo" min="50" max="180" value="100" />
              <span class="tempo-val" id="tempoVal">100 BPM</span>
            </div>
            <div class="row">
              <label for="swNames">Show note names on pan</label>
              <span class="switch"><input type="checkbox" id="swNames" checked /><span class="track"></span><span class="knob"></span></span>
            </div>
            <div class="row">
              <label for="swKeys">Show keyboard keys</label>
              <span class="switch"><input type="checkbox" id="swKeys" /><span class="track"></span><span class="knob"></span></span>
            </div>
            <div class="legend">
              <span><i class="a"></i>struck note</span>
              <span><i class="t"></i>play this next</span>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <footer class="foot">
      Every note is <b>synthesized live</b> with the Web Audio API — no samples. All songs are <b>public-domain / traditional</b>.
      <br /><a href={withBase('theremin/')}>Next in the catalogue: the theremin →</a>
    </footer>
  </div>
</Base>

<script>
  import '../scripts/steelpan.ts';
</script>
