---
/** One page per song this instrument can play, e.g. /kalimba/ode-to-joy/. */
import InstrumentPage from '../../layouts/InstrumentPage.astro';
import Kalimba from '../../instruments/Kalimba.astro';
import { songsFor } from '../../data/song-pages';
import type { Song } from '../../data/songs';

export const getStaticPaths = () => songsFor('kalimba').map((song) => ({ params: { song: song.id }, props: { song } }));
const { song } = Astro.props as { song: Song };
---

<InstrumentPage slug="kalimba" song={song}>
  <Kalimba song={song} />
</InstrumentPage>
