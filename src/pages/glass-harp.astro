---
import Base from '../layouts/Base.astro';
import CoachBand from '../components/CoachBand.astro';
import SongLibrary from '../components/SongLibrary.astro';
import SettingsCard from '../components/SettingsCard.astro';
import InstrumentFooter from '../components/InstrumentFooter.astro';
import '../styles/instrument.css';
import '../styles/glass-harp.css';
import { instrumentBySlug, instrumentJsonLd, breadcrumbJsonLd } from '../data/instruments';
import { SITE, withBase } from '../lib/site';

const inst = instrumentBySlug('glass-harp');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(withBase('og/glass-harp.png'), Astro.site).href;
---

<Base
  title={`Glass Harp — Play Singing Wine Glasses Online | ${SITE.name}`}
  description={inst.description}
  image="og/glass-harp.png"
  imageAlt="Rows of tuned crystal wine glasses on midnight velvet, one rim glowing violet as it sings."
  keywords={inst.keywords}
  jsonLd={[instrumentJsonLd(inst, url, image), breadcrumbJsonLd(inst, url, Astro.site!)]}
  themeColor="#0a0d16"
  favicon="favicon-glass-harp.svg"
>
  <main class="shell" id="main">
    <a class="skip-link" href="#songs">Skip to songs</a>
    <header class="top">
      <div class="brand">
        <h1 class="title">Glass Harp</h1>
        <p class="tag">Musical glasses, as Benjamin Franklin heard them. <b>Press and circle a rim</b> to make a glass sing — faster circles sing louder, several fingers make chords. More water, lower note.</p>
      </div>
      <div class="head-controls">
        <div class="readout" hidden><span class="n" id="lastNote">—</span><span class="h">last glass</span></div>
      </div>
    </header>

    <div class="practice wide">
      <section class="stage" aria-label="Glass harp">
        <div class="table-scroll">
          <div class="table" id="table">
            <span class="rub-hint" aria-hidden="true">press · circle · listen</span>
          </div>
        </div>
        <div class="stage-foot">
          <span>Tap for a <b>ting</b> · circle for a <b>song</b> · lift to let it ring</span>
          <span class="kbd-hint">Hold keys like a piano: <kbd>Z</kbd> <kbd>S</kbd> <kbd>X</kbd> … <kbd>Q</kbd> <kbd>2</kbd> <kbd>W</kbd> …</span>
          <span class="touch-hint">Swipe the empty top of the table to reach every glass.</span>
        </div>
        <noscript><p class="stage-foot">The glass harp needs JavaScript to make sound.</p></noscript>
      </section>

      <CoachBand idle="Pick a song to practise, or just make the glasses sing." />

      <div class="lower">
        <SongLibrary />
        <SettingsCard>
          <div class="row">
            <label for="swNames">Note names under glasses</label>
            <span class="switch"><input type="checkbox" id="swNames" checked /><span class="track"></span><span class="knob"></span></span>
          </div>
          <Fragment slot="legend"><span><i class="a"></i>singing</span><span><i class="t"></i>play this next</span></Fragment>
        </SettingsCard>
      </div>
    </div>

    <InstrumentFooter slug="glass-harp">
      Every glass is <b>synthesized live</b> — no recordings. All songs are <b>public-domain / traditional</b>.
    </InstrumentFooter>
  </main>
</Base>

<script>
  import '../scripts/glass-harp.ts';
</script>
