---
import Base from '../layouts/Base.astro';
import CoachBand from '../components/CoachBand.astro';
import SongLibrary from '../components/SongLibrary.astro';
import SettingsCard from '../components/SettingsCard.astro';
import InstrumentFooter from '../components/InstrumentFooter.astro';
import '../styles/instrument.css';
import '../styles/kalimba.css';
import { instrumentBySlug, instrumentJsonLd, breadcrumbJsonLd } from '../data/instruments';
import { SITE, withBase } from '../lib/site';

const inst = instrumentBySlug('kalimba');
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(withBase('og/kalimba.png'), Astro.site).href;
---

<Base
  title={`Kalimba — Play a Thumb Piano Online | ${SITE.name}`}
  description={inst.description}
  image="og/kalimba.png"
  imageAlt="A wooden 17-key kalimba with silver tines fanning out from the centre, one glowing ember-orange."
  keywords={inst.keywords}
  jsonLd={[instrumentJsonLd(inst, url, image), breadcrumbJsonLd(inst, url, Astro.site!)]}
  themeColor="#16100c"
  favicon="favicon-kalimba.svg"
>
  <main class="shell" id="main">
    <a class="skip-link" href="#songs">Skip to songs</a>
    <header class="top">
      <div class="brand">
        <h1 class="title">Kalimba</h1>
        <p class="tag">A thumb piano: seventeen steel tines on a hollow wooden board. <b>Tap a tine</b> or sweep across them, and read songs in real <b>kalimba number tabs</b>.</p>
      </div>
      <div class="head-controls">
        <div class="readout" hidden><span class="n" id="lastNote">—</span><span class="h">last tine</span></div>
      </div>
    </header>

    <div class="practice side">
      <section class="stage" aria-label="Kalimba">
        <div class="kalimba-wrap">
          <div class="board" aria-hidden="true"></div>
          <div class="saddle" aria-hidden="true"></div>
          <div class="hole" aria-hidden="true"></div>
          <div class="tines" id="tines"></div>
          <div class="bridge" aria-hidden="true"></div>
          <span class="thumb-hint l" aria-hidden="true">left thumb</span>
          <span class="thumb-hint r" aria-hidden="true">right thumb</span>
        </div>
        <div class="stage-foot">
          <span>The lowest note is in the middle; the scale climbs outward — left, right, left.</span>
          <span class="kbd-hint">Keys <kbd>1</kbd>–<kbd>7</kbd>, <kbd>Q</kbd>–<kbd>U</kbd>, <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd></span>
          <span class="touch-hint">Turn your phone sideways for wider tines.</span>
        </div>
        <noscript><p class="stage-foot">The kalimba needs JavaScript to make sound.</p></noscript>
      </section>

      <div class="rail">
        <CoachBand idle="Pick a song to practise, or just pluck the tines. Songs with sharps or flats need a chromatic kalimba." />
        <SongLibrary />
        <SettingsCard>
          <div class="row">
            <span class="label" id="notationLabel">Tine labels</span>
            <span class="seg" role="group" aria-labelledby="notationLabel">
              <button type="button" data-notation="numbers" aria-pressed="true">1 2 3</button>
              <button type="button" data-notation="letters" aria-pressed="false">C D E</button>
            </span>
          </div>
          <div class="row kbd-hint">
            <label for="swKeys">Keyboard keys on tines</label>
            <span class="switch"><input type="checkbox" id="swKeys" /><span class="track"></span><span class="knob"></span></span>
          </div>
          <Fragment slot="legend"><span><i class="a"></i>ringing</span><span><i class="t"></i>play this next</span><span>Dots mark higher octaves</span></Fragment>
        </SettingsCard>
      </div>
    </div>

    <InstrumentFooter slug="kalimba">
      Every tine is <b>synthesized live</b> from cantilever-beam physics. All songs are <b>public-domain / traditional</b>.
    </InstrumentFooter>
  </main>
</Base>

<script>
  import '../scripts/kalimba.ts';
</script>
