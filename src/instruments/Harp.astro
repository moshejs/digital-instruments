---
/** The harp itself: its header, the playable instrument, coach, songs and settings. */
import CoachBand from '../components/CoachBand.astro';
import SongLibrary from '../components/SongLibrary.astro';
import SettingsCard from '../components/SettingsCard.astro';
import '../styles/instrument.css';
import '../styles/harp.css';
import type { Song } from '../data/songs';

interface Props {
  /** Set on a song's own page: the song is preloaded and named in the heading. */
  song?: Song;
}
const { song } = Astro.props;
---

<header class="top">
  <div class="brand">
    <h1 class="title">{song && <span class="kicker">Learn {song.title} on the </span>}Lever Harp</h1>
    <p class="tag">A Celtic lever harp. <b>Pluck a string</b>, or <b>drag across</b> them for a glissando. It's tuned in E♭, and each lever at the top raises its string a semitone. Red strings are C, blue are F.</p>
  </div>
  <div class="head-controls">
    <div class="readout" hidden><span class="n" id="lastNote">—</span><span class="h">last string</span></div>
  </div>
</header>

<div class="practice side">
  <section class="stage" aria-label="Lever harp">
    <div class="harp-wrap"><svg id="harp" role="group" aria-label="Harp strings and levers. Pluck with the number keys; Shift plus a key flips that string's lever."></svg></div>
    <div class="stage-foot">
      <span class="kbd-hint">Keys <kbd>1</kbd>–<kbd>7</kbd>, <kbd>Q</kbd>–<kbd>U</kbd>, <kbd>I</kbd> pluck · <kbd>Shift</kbd> + key flips a lever</span>
      <span class="touch-hint">Tap or drag across the strings; tap a lever to flip it. Turn your phone sideways for a bigger harp.</span>
      <button class="btn" id="btnReset" type="button">Reset levers (C major)</button>
      <span class="lever-note" id="leverNote" aria-hidden="true">Levers: E, A and B raised (C major).</span>
    </div>
    <noscript><p class="stage-foot">The harp needs JavaScript to make sound.</p></noscript>
  </section>

  <div class="rail">
    <CoachBand idle="Pick a song to practise — the levers set themselves for its key — or just play." />
    <SongLibrary />
    <SettingsCard>
      <div class="row">
        <label for="swAuto">Set levers automatically</label>
        <span class="switch"><input type="checkbox" id="swAuto" checked /><span class="track"></span><span class="knob"></span></span>
      </div>
      <Fragment slot="legend"><span><i class="a"></i>sounding · raised lever</span><span><i class="t"></i>play this next</span></Fragment>
    </SettingsCard>
  </div>
</div>

<script>
  import '../scripts/harp.ts';
</script>
