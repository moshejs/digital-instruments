---
import { SITE, withBase } from '../lib/site';
import { INSTRUMENTS } from '../data/instruments';

const path = Astro.url.pathname;
const links = [
  ...INSTRUMENTS.map((i) => ({ href: withBase(`${i.slug}/`), label: i.short })),
  { href: `${withBase()}#songbook`, label: 'Songbook' },
];
---

<nav class="mdi-nav" aria-label="Main">
  <a class="mdi-mark" href={withBase()}>
    <svg viewBox="0 0 32 32" aria-hidden="true" width="22" height="22">
      <circle cx="16" cy="16" r="11" fill="none" stroke="#f6b23c" stroke-width="2.4" />
      <path d="M3 16c3-6 5-6 7 0s4 6 6 0 4-6 6 0 4 6 7 0" fill="none" stroke="#5cf2d6" stroke-width="2.4" stroke-linecap="round" />
    </svg>
    <span>{SITE.name}</span>
  </a>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
      </li>
    ))}
    <li><a href={SITE.repo} rel="noopener">GitHub</a></li>
  </ul>
</nav>

<style>
  /* Self-contained so it reads the same on every instrument's page and theme. */
  .mdi-nav {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px clamp(16px, 3vw, 34px);
    background: rgba(14, 13, 12, 0.86);
    border-bottom: 1px solid rgba(237, 234, 227, 0.1);
    backdrop-filter: blur(8px);
    font-family: 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .mdi-mark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #edeae3;
    text-decoration: none;
    font-family: 'Big Shoulders Display', 'Arial Narrow', sans-serif;
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px clamp(10px, 1.8vw, 22px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    color: #a8a39a;
    text-decoration: none;
    text-transform: uppercase;
    padding: 4px 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  ul a:hover,
  ul a[aria-current='page'] {
    color: #edeae3;
    border-bottom-color: currentColor;
  }
  a:focus-visible {
    outline: 2px solid #5cf2d6;
    outline-offset: 3px;
    border-radius: 2px;
  }
  @media (max-width: 640px) {
    .mdi-nav { flex-direction: column; align-items: flex-start; gap: 8px; }
    .mdi-mark span { font-size: 15px; }
  }
</style>
